{% comment %}
  SocialNest Inline Social Share (App Block)
  Allows merchants to place inline product/page social sharing buttons inside any theme section.
{% endcomment %}

{{ 'socialnest-storefront.css' | asset_url | stylesheet_tag }}
<script src="{{ 'socialnest-storefront.js' | asset_url }}" defer="defer"></script>
<script>window.__sn_page_type = {{ request.page_type | json }};</script>

<div class="socialnest-inline-share"
     data-page-type="{{ request.page_type | escape }}"
     data-align="{{ block.settings.alignment }}"
     data-button-style="{{ block.settings.button_style }}"
     style="text-align: {{ block.settings.alignment }}; margin: 1.5rem 0;">
  {% if block.settings.heading != blank %}
    <h4 class="socialnest-share-heading" style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">
      {{ block.settings.heading }}
    </h4>
  {% endif %}

  <div class="socialnest-share-buttons" style="display: inline-flex; flex-wrap: wrap; gap: 0.5rem; justify-content: {% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};">
    {% if block.settings.show_whatsapp %}
      <a href="https://wa.me/?text={{ page_title | default: shop.name | url_encode }}%20{{ canonical_url | default: request.origin | url_encode }}"
         target="_blank"
         rel="noopener noreferrer"
         class="sn-share-btn sn-share-whatsapp"
         aria-label="Share on WhatsApp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>WhatsApp</span>
      </a>
    {% endif %}

    {% if block.settings.show_facebook %}
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | default: request.origin | url_encode }}"
         target="_blank"
         rel="noopener noreferrer"
         class="sn-share-btn sn-share-facebook"
         aria-label="Share on Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span>Facebook</span>
      </a>
    {% endif %}

    {% if block.settings.show_x %}
      <a href="https://x.com/intent/tweet?url={{ canonical_url | default: request.origin | url_encode }}&text={{ page_title | default: shop.name | url_encode }}"
         target="_blank"
         rel="noopener noreferrer"
         class="sn-share-btn sn-share-x"
         aria-label="Share on X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span>Post</span>
      </a>
    {% endif %}

    {% if block.settings.show_pinterest %}
      <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | default: request.origin | url_encode }}&description={{ page_title | default: shop.name | url_encode }}"
         target="_blank"
         rel="noopener noreferrer"
         class="sn-share-btn sn-share-pinterest"
         aria-label="Pin on Pinterest">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
        <span>Pin</span>
      </a>
    {% endif %}

    {% if block.settings.show_copy_link %}
      <button type="button"
              class="sn-share-btn sn-share-copy"
              onclick="SocialNestStorefront.copyCurrentPageLink(this)"
              aria-label="Copy page link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <span>Copy Link</span>
      </button>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "SocialNest Share Buttons",
  "target": "section",
  "stylesheet": "socialnest-storefront.css",
  "javascript": "socialnest-storefront.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Share this with friends:"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "pill", "label": "Pill (Rounded)" },
        { "value": "square", "label": "Slightly Rounded" },
        { "value": "minimal", "label": "Minimal / Outline" }
      ],
      "default": "pill"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "Show X / Twitter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Show Pinterest",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copy_link",
      "label": "Show Copy Link Button",
      "default": true
    }
  ]
}
{% endschema %}
