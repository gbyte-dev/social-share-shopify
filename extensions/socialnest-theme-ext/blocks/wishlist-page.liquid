{% comment %}
  SocialNest Wishlist Page (App Block)
  Allows merchants to add a dedicated responsive Wishlist grid to any page or section via Theme Editor.
{% endcomment %}

{{ 'socialnest-storefront.css' | asset_url | stylesheet_tag }}
<script src="{{ 'socialnest-wishlist.js' | asset_url }}" defer="defer"></script>

<style>
  /* Hide the theme's default page title (e.g. Dawn/Horizon h1.main-page-title "Wishlist")
     on the Wishlist page, keeping the SocialNest "My Wishlist" block heading and item count. */
  .main-page-title,
  h1.page-title:not(.sn-wishlist-title),
  .page-header h1:not(.sn-wishlist-title),
  .section-header__title:not(.sn-wishlist-title),
  .section-header h1:not(.sn-wishlist-title),
  .shopify-section:has(.socialnest-wishlist-page-wrapper) h1:not(.sn-wishlist-title) {
    display: none !important;
  }
</style>

<div class="socialnest-wishlist-page-wrapper"
     data-columns="{{ block.settings.grid_columns | default: 4 }}"
     data-empty-heading="{{ block.settings.empty_heading | default: 'Your wishlist is empty' | escape }}"
     data-empty-text="{{ block.settings.empty_text | default: 'Explore our catalog and click the heart icon on any product to save it here.' | escape }}"
     data-continue-url="{{ block.settings.continue_url | default: routes.all_products_collection_url | default: '/collections/all' | escape }}"
     data-continue-label="{{ block.settings.continue_label | default: 'Continue Shopping' | escape }}"
     style="--sn-grid-cols: {{ block.settings.grid_columns | default: 4 }};">
  
  {% if block.settings.heading != blank %}
    <div class="sn-wishlist-header">
      <h1 class="sn-wishlist-title">{{ block.settings.heading | escape }}</h1>
      <span class="sn-wishlist-total-count" aria-live="polite"></span>
    </div>
  {% endif %}

  <div id="socialnest-wishlist-grid-root" class="sn-wishlist-grid" aria-live="polite">
    <!-- Populated dynamically by socialnest-wishlist.js -->
  </div>
</div>

{% schema %}
{
  "name": "SocialNest Wishlist",
  "target": "section",
  "stylesheet": "socialnest-storefront.css",
  "javascript": "socialnest-wishlist.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Grid Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Empty State Settings"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty State Title",
      "default": "Your wishlist is empty"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty State Subtitle",
      "default": "Explore our catalog and click the heart icon on any product to save it here."
    },
    {
      "type": "url",
      "id": "continue_url",
      "label": "Continue Shopping Link"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue Shopping Button Label",
      "default": "Continue Shopping"
    }
  ]
}
{% endschema %}
